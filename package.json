{
  "name": "dangly",
  "productName": "Dangly",
  "version": "0.2.1",
  "private": true,
  "description": "Lucky charms, rituals and weather hanging on your desktop, for Mac and PC",
  "main": "src/main/main.js",
  "author": "Dangly",
  "scripts": {
    "start": "electron .",
    "generate-icons": "python3 scripts/generate-icons.py",
    "generate-dmg-background": "python3 scripts/generate-dmg-background.py",
    "generate-dmg-file-icon": "python3 scripts/generate-dmg-file-icon.py",
    "generate-windows-icon": "python3 scripts/generate-windows-icon.py",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.dangly.app",
    "productName": "Dangly",
    "files": [
      "src/**/*",
      "catalog/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterAllArtifactBuild": "scripts/set-dmg-icon.js",
    "publish": {
      "provider": "github",
      "owner": "bbalakrish-eng",
      "repo": "dangly"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Dangly-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Dangly ${version}",
      "background": "assets/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        { "x": 170, "y": 210, "type": "file" },
        { "x": 490, "y": 210, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "assets/windows-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dangly-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
