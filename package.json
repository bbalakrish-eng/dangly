{
  "name": "dangly",
  "productName": "Dangly",
  "version": "0.2.4",
  "private": true,
  "description": "Lucky charms, rituals and weather hanging on your desktop, for Mac and PC",
  "main": "src/main/main.js",
  "author": "Dangly",
  "scripts": {
    "start": "electron .",
    "generate-icons": "python3 scripts/generate-icons.py",
    "generate-dmg-background": "python3 scripts/generate-dmg-background.py",
    "generate-dmg-file-icon": "python3 scripts/generate-dmg-file-icon.py",
    "generate-windows-icon": "python3 scripts/generate-windows-icon.py",
    "install-dmgbuild": "pip3 install --user dmgbuild",
    "package:mac": "electron-builder --mac && python3 scripts/build-dmg.py",
    "package:mac:publish": "electron-builder --mac --publish always && python3 scripts/build-dmg.py",
    "package:win": "electron-builder --win",
    "package:win:publish": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.dangly.app",
    "productName": "Dangly",
    "files": [
      "src/**/*",
      "catalog/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterSign": "scripts/after-sign.js",
    "publish": {
      "provider": "github",
      "owner": "bbalakrish-eng",
      "repo": "dangly"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Dangly-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/windows-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dangly-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
